# CHATFORGE — environment variables (all optional for mock mode).
# Copy to .env. Leave blank to run in mock mode (MockWhatsApp + MockLLM + MockPaystack).

# PostgreSQL (Neon) — required to run prisma push/migrate/seed and the real DB.
DATABASE_URL="postgresql://chatforge:change_me@localhost:5432/chatforge?schema=public"

# Redis (Upstash) — BullMQ queue. Empty = in-memory/disabled fallback.
REDIS_URL=""

# AI (OpenAI-compatible; point OPENAI_BASE_URL at OpenRouter to use Claude/GPT).
# Empty = rule-based MockLLM with Pidgin keyword rules.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# WhatsApp Cloud API (Meta). Empty = MockWhatsApp that logs to console + DB.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="chatforge_verify"

# Paystack (NGN). Empty = MockPaystack that generates fake links + logs.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# NextAuth
NEXTAUTH_SECRET="change_me_to_a_long_random_string"
NEXTAUTH_URL="http://localhost:3000"

# Plan prices (₦/mo)
CHATFORGE_BASIC_PRICE_NGN=15000
CHATFORGE_PRO_PRICE_NGN=35000
