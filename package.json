{
  "name": "chatforge-whatsapp-ai-saas",
  "version": "1.0.0",
  "private": true,
  "description": "CHATFORGE — WhatsApp AI Sales Agent SaaS (Nigeria). Multi-tenant sales agent that talks in English + Pidgin, qualifies leads, quotes with Paystack, follows up and escalates.",
  "scripts": {
    "dev:web": "pnpm --filter @chatforge/web dev",
    "dev:worker": "pnpm --filter @chatforge/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "smoke:webhook": "bash scripts/test-webhook.sh",
    "smoke:conversation": "bash scripts/mock-conversation.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
