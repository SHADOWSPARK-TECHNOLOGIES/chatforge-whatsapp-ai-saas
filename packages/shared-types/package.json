{
  "name": "@chatforge/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "CHATFORGE shared TypeScript domain types (tenant, lead, conversation, message, intent, products, payments).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
